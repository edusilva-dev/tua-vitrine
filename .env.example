# O ambiente local funciona sem configurar variáveis: banco, URL, e-mail em arquivo,
# storage e testes já possuem defaults compatíveis com o Compose.

# Descomente apenas para usar um PostgreSQL diferente do Compose.
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/tua_vitrine

# Descomente para testar cadastro e login localmente. Sem este segredo, o painel local
# abre no modo de desenvolvimento sem contas.
# BETTER_AUTH_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# Opcionais no desenvolvimento local.
# APP_URL=http://localhost:3000
# SUPPORT_EMAIL=suporte@example.com
