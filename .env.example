# Local prototype only. Do not copy real credentials into version control.
APP_ENV=development
APP_URL=http://localhost:3000
LOCAL_ONLY=true
AUTH_MODE=local
# Para experimentar contas: AUTH_MODE=session e gere um segredo aleatório de 32+ caracteres.
# BETTER_AUTH_SECRET=
MAIL_TRANSPORT=file
MAIL_OUTBOX_DIR=./work/mail-outbox
MAIL_FROM=noreply@tuavitrine.local
# E-mail que receberá as solicitações enviadas pela aba Suporte.
SUPPORT_EMAIL=
# Para produção com Resend: MAIL_TRANSPORT=resend
# RESEND_API_KEY=
# RESEND_EMAIL_DOMAIN=vitrine.fyweb.com.br
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
DATABASE_URL=postgresql://tuavitrine:tuavitrine_local@localhost:55432/tuavitrine
# Em Neon/Vercel, use uma URL com -pooler no runtime e a URL direta nas migrações.
# A integração Neon normalmente chama a URL direta de DATABASE_URL_UNPOOLED.
DIRECT_URL=
DATABASE_URL_UNPOOLED=
DATABASE_POOL_MAX=10
STORAGE_DRIVER=local
STORAGE_DIR=./work/storage
# Na Vercel: STORAGE_DRIVER=vercel-blob e conecte um Blob store ao projeto.
# BLOB_READ_WRITE_TOKEN=
# Mantenha disabled até configurar todas as credenciais e preços abaixo.
BILLING_MODE=disabled
# Assinaturas Stripe (Essencial R$ 19/mês e Profissional R$ 39/mês).
# STRIPE_SECRET_KEY=rk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_BASIC_MONTHLY=price_...
# STRIPE_PRICE_PRO_MONTHLY=price_...
TEST_DATABASE_URL=postgresql://tuavitrine:tuavitrine_local@localhost:55432/tuavitrine_test
