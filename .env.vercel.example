# Configure estes valores no painel da Vercel. Não crie um .env de produção versionado.
APP_ENV=production
APP_URL=https://SEU-SUBDOMINIO.fyweb.com.br
LOCAL_ONLY=false
AUTH_MODE=session
BETTER_AUTH_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# A Vercel precisa somente da URL pooled. Guarde a URL direta fora do runtime.
DATABASE_URL=postgresql://USUARIO:SENHA@ENDPOINT-pooler.REGIAO.aws.neon.tech/BANCO?sslmode=require
DATABASE_POOL_MAX=1

# Crie um Blob store público no projeto; a Vercel injeta este token automaticamente.
STORAGE_DRIVER=vercel-blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_substitua
STORAGE_DIR=/tmp/tua-vitrine-unused

# A integração Resend injeta as duas variáveis abaixo.
MAIL_TRANSPORT=resend
MAIL_FROM=conta@vitrine.fyweb.com.br
SUPPORT_EMAIL=suporte@fyweb.com.br
RESEND_API_KEY=re_injetada_pela_integracao
RESEND_EMAIL_DOMAIN=vitrine.fyweb.com.br
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=substitua
SMTP_PASSWORD=substitua

# Troque para stripe somente depois de configurar os quatro valores abaixo.
BILLING_MODE=disabled
# Use uma chave restrita e marque os segredos como Sensitive na Vercel.
STRIPE_SECRET_KEY=rk_live_substitua
STRIPE_WEBHOOK_SECRET=whsec_substitua
STRIPE_PRICE_BASIC_MONTHLY=price_substitua_basic_1900_brl_mes
STRIPE_PRICE_PRO_MONTHLY=price_substitua_pro_3900_brl_mes
