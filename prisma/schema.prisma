generator client {
  provider = "prisma-client"
  output = "../generated/prisma"
}
datasource db {
  provider = "postgresql"
}
enum StoreStatus {
 DRAFT
 ACTIVE
}
enum BillingPlan {
 FREE
 ESSENTIAL
 PROFESSIONAL
}
enum SubscriptionStatus {
 INCOMPLETE
 INCOMPLETE_EXPIRED
 TRIALING
 ACTIVE
 PAST_DUE
 CANCELED
 UNPAID
 PAUSED
}
model Store {
 id String @id @default(uuid()) @db.Uuid
 name String
 slug String @unique
 whatsapp String?
 status StoreStatus @default(DRAFT)
 primaryColor String @default("#2563eb")
 template String @default("grid")
 customization Json @default("{\"version\":1,\"tagline\":\"\"}")
 logoAssetId String? @db.Uuid
 onboardingCompletedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 products Product[]
 categories Category[]
 assets Asset[]
 events MetricEvent[]
 likes ProductLike[]
 idempotencies Idempotency[]
 members StoreMember[]
 subscription StoreSubscription?
 promotionCampaign PromotionCampaign?
}
model StoreSubscription {
 id String @id @default(uuid()) @db.Uuid
 storeId String @unique @db.Uuid
 stripeCustomerId String @unique
 stripeSubscriptionId String? @unique
 plan BillingPlan?
 status SubscriptionStatus?
 currentPeriodEnd DateTime?
 trialEnd DateTime?
 trialUsedAt DateTime?
 cancelAtPeriodEnd Boolean @default(false)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}
model StripeWebhookEvent {
 id String @id
 type String
 processedAt DateTime @default(now())
}
model Category {
 slug String
 id String @id @default(uuid()) @db.Uuid
 storeId String @db.Uuid
 name String
 store Store @relation(fields:[storeId], references:[id], onDelete:Cascade)
 products Product[]
 @@unique([storeId,id])
 @@unique([storeId,name])
 @@unique([storeId,slug])
}
model Product {
 id String @id @default(uuid()) @db.Uuid
 storeId String @db.Uuid
 categoryId String? @db.Uuid
 name String
 description String
 priceCents Int
 discountPriceCents Int?
 available Boolean @default(true)
 published Boolean @default(true)
 archivedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 store Store @relation(fields:[storeId], references:[id], onDelete:Cascade)
 category Category? @relation(fields:[storeId,categoryId], references:[storeId,id])
 images ProductImage[]
 variants ProductVariant[]
 options ProductOption[]
 idempotencies Idempotency[]
 likes ProductLike[]
 events MetricEvent[]
 campaignSelections PromotionCampaignProduct[]
 @@unique([storeId,id])
 @@index([storeId,archivedAt,createdAt])
}
model ProductVariant {
 id String @id @default(uuid()) @db.Uuid
 storeId String @db.Uuid
 productId String @db.Uuid
 label String
 combinationKey String
 priceCents Int
 discountPriceCents Int?
 available Boolean
 product Product @relation(fields:[storeId,productId], references:[storeId,id], onDelete:Cascade)
 values VariantOptionValue[]
 @@unique([storeId,productId,id])
 @@unique([productId,combinationKey])
}
model Asset {
 id String @id @default(uuid()) @db.Uuid
 storeId String @db.Uuid
 storageKey String @unique
 mime String
 bytes Int
 width Int
 height Int
 createdAt DateTime @default(now())
 store Store @relation(fields:[storeId], references:[id], onDelete:Cascade)
 images ProductImage[]
 promotionBanners PromotionCampaign[]
 @@unique([storeId,id])
}
model ProductImage {
 id String @id @default(uuid()) @db.Uuid
 storeId String @db.Uuid
 productId String @db.Uuid
 assetId String @db.Uuid
 position Int
 product Product @relation(fields:[storeId,productId], references:[storeId,id], onDelete:Cascade)
 asset Asset @relation(fields:[storeId,assetId], references:[storeId,id])
 @@unique([productId,assetId])
}
model AnonymousSession {
 id String @id @default(uuid()) @db.Uuid
 tokenHash String @unique
 createdAt DateTime @default(now())
 expiresAt DateTime
 events MetricEvent[]
 likes ProductLike[]
}
model MetricEvent {
 id String @id @default(uuid()) @db.Uuid
 storeId String @db.Uuid
 productId String? @db.Uuid
 sessionId String @db.Uuid
 type String
 eventId String @db.Uuid
 dedupeKey String @unique
 occurredAt DateTime @default(now())
 store Store @relation(fields:[storeId], references:[id], onDelete:Cascade)
 product Product? @relation(fields:[storeId,productId], references:[storeId,id])
 session AnonymousSession @relation(fields:[sessionId], references:[id], onDelete:Cascade)
 @@unique([storeId,eventId])
 @@index([storeId,type,occurredAt])
}
model ProductLike {
 id String @id @default(uuid()) @db.Uuid
 storeId String @db.Uuid
 productId String @db.Uuid
 sessionId String @db.Uuid
 createdAt DateTime @default(now())
 store Store @relation(fields:[storeId], references:[id], onDelete:Cascade)
 product Product @relation(fields:[storeId,productId], references:[storeId,id])
 session AnonymousSession @relation(fields:[sessionId], references:[id], onDelete:Cascade)
 @@unique([storeId,productId,sessionId])
}
model Idempotency {
 id String @id @default(uuid()) @db.Uuid
 storeId String @db.Uuid
 key String
 requestHash String
 productId String @db.Uuid
 product Product @relation(fields:[storeId,productId], references:[storeId,id], onDelete:Cascade)
 store Store @relation(fields:[storeId], references:[id], onDelete:Cascade)
 @@unique([storeId,key])
}

model ProductOption {
 id String @id @default(uuid()) @db.Uuid
 storeId String @db.Uuid
 productId String @db.Uuid
 name String
 product Product @relation(fields:[storeId,productId], references:[storeId,id], onDelete:Cascade)
 values ProductOptionValue[]
 @@unique([storeId,productId,id])
 @@unique([productId,name])
}
model ProductOptionValue {
 id String @id @default(uuid()) @db.Uuid
 storeId String @db.Uuid
 productId String @db.Uuid
 optionId String @db.Uuid
 value String
 option ProductOption @relation(fields:[storeId,productId,optionId], references:[storeId,productId,id], onDelete:Cascade)
 variants VariantOptionValue[]
 @@unique([storeId,productId,optionId,id])
 @@unique([optionId,value])
}
model VariantOptionValue {
 storeId String @db.Uuid
 productId String @db.Uuid
 variantId String @db.Uuid
 optionId String @db.Uuid
 valueId String @db.Uuid
 variant ProductVariant @relation(fields:[storeId,productId,variantId], references:[storeId,productId,id], onDelete:Cascade)
 value ProductOptionValue @relation(fields:[storeId,productId,optionId,valueId], references:[storeId,productId,optionId,id], onDelete:Cascade)
 @@id([variantId,optionId])
}

model User {
 id String @id
 name String
 email String @unique
 emailVerified Boolean @default(false)
 image String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 sessions Session[]
 accounts Account[]
 memberships StoreMember[]
}

model Session {
 id String @id
 token String @unique
 expiresAt DateTime
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 ipAddress String?
 userAgent String?
 userId String
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 @@index([userId])
}

model Account {
 id String @id
 accountId String
 providerId String
 userId String
 accessToken String?
 refreshToken String?
 idToken String?
 accessTokenExpiresAt DateTime?
 refreshTokenExpiresAt DateTime?
 scope String?
 password String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 @@unique([providerId, accountId])
 @@index([userId])
}

model Verification {
 id String @id
 identifier String
 value String
 expiresAt DateTime
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([identifier])
}

model RateLimit {
 id String @id
 key String @unique
 count Int
 lastRequest BigInt
}

model StoreMember {
 storeId String @db.Uuid
 userId String
 role String @default("OWNER")
 createdAt DateTime @default(now())
 store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 @@id([storeId, userId])
 @@unique([userId])
}

model PromotionCampaign {
 id String @id @default(uuid()) @db.Uuid
 storeId String @unique @db.Uuid
 title String
 description String
 ctaLabel String
 active Boolean @default(false)
 bannerAssetId String? @db.Uuid
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
 bannerAsset Asset? @relation(fields: [storeId, bannerAssetId], references: [storeId, id])
 products PromotionCampaignProduct[]
 @@unique([storeId, id])
}

model PromotionCampaignProduct {
 storeId String @db.Uuid
 campaignId String @db.Uuid
 productId String @db.Uuid
 position Int @default(0)
 campaign PromotionCampaign @relation(fields: [storeId, campaignId], references: [storeId, id], onDelete: Cascade)
 product Product @relation(fields: [storeId, productId], references: [storeId, id], onDelete: Cascade)
 @@id([campaignId, productId])
 @@index([storeId, position])
}
