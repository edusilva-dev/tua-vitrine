{
  "name": "tua-vitrine",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --bun next dev --webpack --hostname 127.0.0.1",
    "build": "bun --bun next build --webpack",
    "start": "bun --bun next start --hostname 127.0.0.1",
    "lint": "bun --bun biome check . && bun --bun eslint . --max-warnings 0",
    "lint:fix": "bun --bun biome check --write . && bun --bun eslint . --fix",
    "format": "bun --bun biome format --write .",
    "typecheck": "bun --bun next typegen && bun --bun tsc --noEmit",
    "test": "bun test",
    "test:e2e": "bun --bun playwright test",
    "test:auth": "bun --bun playwright test --config playwright.auth.config.ts",
    "assets:cleanup": "bun --env-file=.env.local --conditions=react-server scripts/cleanup-assets.ts",
    "auth:cleanup": "bun --env-file=.env.local --conditions=react-server scripts/cleanup-auth.ts",
    "store:assign-owner": "bun --env-file=.env.local --conditions=react-server scripts/assign-store-owner.ts",
    "check": "bun run lint && bun run typecheck && bun run test",
    "db:generate": "bun --bun prisma generate --config prisma7.config.ts",
    "db:migrate": "bun --bun prisma migrate dev --config prisma7.config.ts",
    "db:deploy": "bun --bun prisma migrate deploy --config prisma7.config.ts",
    "db:seed": "bun prisma/seed.ts",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@vercel/blob": "2.8.0",
    "@vercel/functions": "3.9.9",
    "better-auth": "1.7.5",
    "class-variance-authority": "0.7.1",
    "cn": "0.3.2",
    "dotenv": "18.0.2",
    "lucide-react": "1.47.0",
    "next": "16.3.6",
    "next-themes": "0.4.6",
    "nodemailer": "10.0.10",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "qrcode": "1.5.4",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.88.0",
    "resend": "6.28.1",
    "server-only": "0.0.1",
    "shadcn": "4.21.0",
    "sharp": "0.35.4",
    "sonner": "2.0.8",
    "stripe": "22.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.11.0",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "mysql2": "3.23.1"
  }
}
